  },
  "components": {
    "schemas": {
      "CreateCarDto": {
        "required": [
          "brand",
          "fuelType",
          "imageUrl",
          "model",
          "registrationNumber",
          "transmission",
          "variant"
        ],
        "type": "object",
        "properties": {
          "brand": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "model": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "variant": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "year": {
            "maximum": 2100,
            "minimum": 1900,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "maximum": 9999999999,
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "mileage": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "fuelType": {
            "minLength": 1,
            "type": "string"
          },
          "transmission": {
            "minLength": 1,
            "type": "string"
          },
          "registrationNumber": {
            "maxLength": 20,
            "minLength": 0,
            "pattern": "(?i)^(?:[A-Z]{2}-\\d{2}-[A-Z]{1,3}-\\d{1,4}|\\d{2}BH\\d{4}[A-HJ-NP-Z]{1,2})$",
            "type": "string"
          },
          "imageUrl": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "CreateCustomerDto": {
        "required": [
          "city",
          "email",
          "fullName",
          "phone",
          "state"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "minLength": 1,
            "pattern": "^\\d{10}$",
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "state": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateSaleDto": {
        "required": [
          "paymentMethod"
        ],
        "type": "object",
        "properties": {
          "carId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "customerId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "paymentMethod": {
            "minLength": 1,
            "pattern": "^(UPI|Bank Transfer|Car Loan / Finance|Cash)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateCarDto": {
        "required": [
          "brand",
          "fuelType",
          "imageUrl",
          "model",
          "registrationNumber",
          "transmission",
          "variant"
        ],
        "type": "object",
        "properties": {
          "brand": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "model": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "variant": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "year": {
            "maximum": 2100,
            "minimum": 1900,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "maximum": 9999999999,
            "minimum": 1,
            "type": "number",
            "format": "double"
          },
          "mileage": {
            "maximum": 1000000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "fuelType": {
            "minLength": 1,
            "type": "string"
          },
          "transmission": {
            "minLength": 1,
            "type": "string"
          },
          "registrationNumber": {
            "maxLength": 20,
            "minLength": 0,
            "pattern": "(?i)^(?:[A-Z]{2}-\\d{2}-[A-Z]{1,3}-\\d{1,4}|\\d{2}BH\\d{4}[A-HJ-NP-Z]{1,2})$",
            "type": "string"
          },
          "imageUrl": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      },
      "UpdateCustomerDto": {
        "required": [
          "city",
          "email",
          "fullName",
          "phone",
          "state"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "minLength": 1,
            "pattern": "^\\d{10}$",
            "type": "string"
          },
          "city": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "state": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}