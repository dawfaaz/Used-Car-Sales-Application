          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Cars"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCarDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCarDto"
              }
            },
            "application/*+json": {
              "schema": {
